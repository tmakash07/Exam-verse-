rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ---- Users: created/aggregated ONLY by Cloud Functions ----
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, delete: if false;
      // students may touch ONLY these keys. role, scores, streak, stats etc. are blocked.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'avatarUrl', 'settings', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 80;

      // Attempts are created, scored and closed by Cloud Functions only.
      match /attempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;

        function attempt() { return get(/databases/$(database)/documents/users/$(uid)/attempts/$(attemptId)).data; }

        // Autosave drafts: selectedAnswer only, while in_progress and before deadline (+15s grace).
        match /responses/{qid} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && attempt().status == 'in_progress'
            && request.time < attempt().deadline + duration.value(15, 's')
            && qid in attempt().questionOrder
            && request.resource.data.keys().hasOnly(['selectedAnswer', 'marked', 'timeSpent', 'answeredAt'])
            && (request.resource.data.selectedAnswer == null || request.resource.data.selectedAnswer in ['A', 'B', 'C', 'D']);
          allow delete: if false;
        }

        // Authoritative answers (with correct answer + explanation) are written at submission by the server.
        match /answers/{qid} {
          allow read: if isOwner(uid) || isAdmin();
          allow write: if false;
        }
      }

      match /bookmarks/{questionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['questionId', 'examId', 'createdAt'])
          && request.resource.data.questionId == questionId;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
      match /achievements/{id} { allow read: if isOwner(uid); allow write: if false; }
      match /mistakes/{id} { allow read: if isOwner(uid); allow write: if false; }
      match /notifications/{id} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ---- Exams (students see published/daily only) ----
    match /exams/{examId} {
      allow read: if isAdmin() || resource.data.isPublished == true || resource.data.isDaily == true;
      allow write: if isAdmin();
      // Questions contain correctAnswer: ADMIN ONLY. Students get answer-free payloads from Cloud Functions.
      match /questions/{qid} {
        allow read, write: if isAdmin();
      }
    }
    // collection-group reads of questions are also admin only
    match /{path=**}/questions/{qid} { allow read: if isAdmin(); }

    match /attemptKeys/{id} { allow read, write: if false; }

    match /achievements/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /leaderboards/{board}/entries/{uid} { allow read: if signedIn(); allow write: if false; }
    match /meta/{doc} { allow read: if signedIn(); allow write: if false; }
    match /announcements/{id} { allow read: if signedIn(); allow write: if false; }
    match /stats/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /statsDaily/{doc} { allow read: if isAdmin(); allow write: if false; }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'examId', 'questionId', 'reason', 'status', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }
  }
}
